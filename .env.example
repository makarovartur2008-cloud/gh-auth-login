# Токен бота от @BotFather
BOT_TOKEN=
# Ключ ИИ (ProxyAPI.ru или любой OpenAI-совместимый сервис)
AI_API_KEY=
AI_BASE_URL=https://api.proxyapi.ru/openai/v1
AI_MODEL=gpt-4o-mini
AI_STT_MODEL=whisper-1
# Домен сервера. Без покупки домена: IP с точками заменить на дефисы + .sslip.io, например 1-2-3-4.sslip.io
DOMAIN=
WEBAPP_URL=https://${DOMAIN}
TZ=Europe/Moscow
MORNING_HOUR=8
EVENING_HOUR=20
FRIEND_FEE=50
# Телефон для листовки и страницы заказа (можно оставить пустым)
CONTACT_PHONE=89083003917
SACK_KG=25
# Бот в мессенджере MAX для сообщений клиентам (токен с business.max.ru → Чат-боты → Настройки). Можно пусто
MAX_BOT_TOKEN=
# SMS клиентам через sms.ru (платно, несколько рублей за SMS). Пусто — SMS не шлём
SMS_RU_API_ID=
# --- Маршрут и время доставки ---
# Город — подставляется к адресам при поиске на карте
CITY=Самара
# Откуда выезжаешь (улица, дом). Пусто — маршрут начнётся с первого адреса
DEPOT_ADDRESS=Олимпийская улица, 68
# Во сколько выезд
ROUTE_START=10:00
# Минут на одну точку (донести мешки, рассчитаться)
SERVICE_MIN=10
# Ширина окна прибытия, которое называем клиенту (минут)
ETA_WINDOW_MIN=60
# Поправка на пробки (бесплатные карты пробок не знают)
TRAFFIC_FACTOR=1.3
